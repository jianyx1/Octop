#!/bin/bash
#
# octop — 飞牛本地版「官方 CLI」包装
#
# 复刻 octop 运行环境后调用 `python -m octop.cli.main`，因此可使用全部官方子命令：
#   octop --help
#   octop version
#   octop provider list
#   octop agent list
#   octop user list
#   ...（还包括 init / run / config / backup / skills / update / clean 等）
#
# 注意：本机 Web 服务由飞牛应用中心托管（cmd/main 拉起 bin/octop），
# 请勿手动执行 `octop run`（会与飞牛管理的实例抢 8089 端口）。
#
# 本包装以 octop-native 身份运行，避免产生 root 所有的数据文件
# （Web 服务本身也以 octop-native 运行，混用 root 会导致后续权限问题）。
# root 调用 sudo 免密；其他用户调用需输入自身 sudo 密码。
#
set -euo pipefail

# SSH 不会继承飞牛应用中心的 TRIM_APPDEST。PATH 上的 octop 是安装
# 回调创建的软链接，跟随它才能找到位于数据卷上的应用载荷。
APP_ROOT="/var/apps/octop-native"
APPDEST="${TRIM_APPDEST:-$(dirname "$(dirname "$(readlink -f -- "$0")")")}"
PKGVAR="${TRIM_PKGVAR:-$APP_ROOT/var}"
SITE_PACKAGES="$APPDEST/site-packages"

if [ ! -r "$SITE_PACKAGES/octop/cli/main.py" ]; then
    echo "[octop] 未找到已安装的核心包：$SITE_PACKAGES。请在飞牛应用中心检查 Octop 的安装。" >&2
    exit 1
fi

# 管理目录与应用载荷分开。直接调用时仍从应用中心目录加载共享函数。
_OCTOP_COMMON="$APPDEST/cmd/common.sh"
[ -f "$_OCTOP_COMMON" ] || _OCTOP_COMMON="$APP_ROOT/cmd/common.sh"
[ -f "$_OCTOP_COMMON" ] && source "$_OCTOP_COMMON"

# 数据共享链接属于管理目录，与应用载荷所在卷无关。
DATA_SHARES="${TRIM_DATA_SHARE_PATHS:-}"
DATA_DIR="${DATA_SHARES%%:*}"
DATA_DIR="${DATA_DIR:-$APP_ROOT/shares/octop-native/data}"

# 数据目录由应用中心初始化。普通 SSH 用户可能没有读取向导配置的权限。
if [ -r "$PKGVAR/.env" ]; then
    set -a; . "$PKGVAR/.env"; set +a
fi

# 查找飞牛应用商店提供的 Python 3.12

if type octop_assert_native_arch >/dev/null 2>&1; then
    if ! REASON="$(octop_assert_native_arch)"; then
        echo "[octop] $REASON" >&2
        exit 1
    fi
fi

if type octop_prepend_fnos_node_path >/dev/null 2>&1; then
    octop_prepend_fnos_node_path
fi

PY="$(find_python312)" || {
    echo "错误：未找到 Python 3.12，请先在飞牛应用中心安装「Python 3.12」开发工具。" >&2
    exit 1
}

# 关键环境变量：让 octop 找到包本体（site-packages）与你的数据目录
export PYTHONPATH="${SITE_PACKAGES}${PYTHONPATH:+:$PYTHONPATH}"
export HOME="$DATA_DIR"
export OCTOP_HOME="$DATA_DIR/.octop"
export OCTOP_DATA_DIR="$DATA_DIR"

# 飞牛 FPK 部署标识 + 打包 site-packages 路径：内置在线升级安装到此目录
# （launcher 实际加载的位置），重启服务后即加载新版，升级真正生效
# （见 src/octop/infra/setup/self_update.py 的 _run_fpk_upgrade）。
export OCTOP_INSTALL_MODE="fpk-native"
export OCTOP_FPK_SITE_PACKAGES="$SITE_PACKAGES"

# 以 octop-native 身份运行，避免产生 root 所有的数据文件
if id octop-native >/dev/null 2>&1 && command -v sudo >/dev/null 2>&1; then
    exec sudo -u octop-native \
        PYTHONPATH="$PYTHONPATH" \
        HOME="$HOME" \
        OCTOP_HOME="$OCTOP_HOME" \
        OCTOP_DATA_DIR="$OCTOP_DATA_DIR" \
        OCTOP_INSTALL_MODE="$OCTOP_INSTALL_MODE" \
        OCTOP_FPK_SITE_PACKAGES="$OCTOP_FPK_SITE_PACKAGES" \
        "$PY" -m octop.cli.main "$@"
else
    exec "$PY" -m octop.cli.main "$@"
fi
